# ─────────────────────────────────────────────
# Resource Hub Server — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to source control
# ─────────────────────────────────────────────

# MongoDB connection (local)
MONGO_URI=mongodb://127.0.0.1:27017/resource_hub

# Express session secret — use a long random string in production
SESSION_SECRET=replace_this_with_a_very_long_random_secret_string_at_least_32_chars

# Server port
PORT=5000

# Client origin for CORS (local Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development

# Session max age in milliseconds (default: 7 days)
SESSION_MAX_AGE=604800000

# Test database — used only during npm test, isolated from dev data
TEST_MONGO_URI=mongodb://127.0.0.1:27017/resource_hub_test
